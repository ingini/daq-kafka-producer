# ============================================================
#  daq-kafka-producer  배포 설정
#  이 파일만 수정하면 됩니다.
# ============================================================

# ── 차량 / 배포 식별자 ────────────────────────────────────────
VEHICLE_ID=AP500L-001

# ── 카메라 장치 ───────────────────────────────────────────────
CAM0_DEVICE=/dev/video0
CAM1_DEVICE=/dev/video1
CAM2_DEVICE=/dev/video2
CAM_WIDTH=640
CAM_HEIGHT=360
JPEG_QUALITY=90

# ── GNSS (BynavX1 UDP) ────────────────────────────────────────
GNSS_UDP_PORT=1111
GNSS_SRC_IP=192.168.20.50

# ── Remote Kafka REST Proxy ───────────────────────────────────
# swm-daq.ddns.net → noip 에 등록한 공인 IP → 공유기 포트포워딩 → 192.168.1.66:8082
BROKER_REST_URL=http://swm-daq.ddns.net:8082

# daq-service/server.py 의 _send_kafka() 가 아래 토픽으로 POST 함
# REST Proxy v2 API: POST /topics/{topic_name}
BROKER_TOPIC_CAM0=sensor.cam0.jpeg
BROKER_TOPIC_CAM1=sensor.cam1.jpeg
BROKER_TOPIC_CAM2=sensor.cam2.jpeg
BROKER_TOPIC_GNSS=sensor.gnss

# ── gRPC 포트 ─────────────────────────────────────────────────
SERVICE_GRPC_PORT=50051
GATEWAY_GRPC_PORT=50050

# ── Harbor 이미지 레지스트리 ──────────────────────────────────
REGISTRY=
IMAGE_TAG=1.0.0

# PARQUET_ROLL_ROWS=500
USB_MOUNT_ROOT=/media/swm
