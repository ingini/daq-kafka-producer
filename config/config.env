# ============================================================
#  daq-kafka-producer  배포 설정  (daq-service 용)
#  이 파일만 수정하면 됩니다.
# ============================================================

# ── 차량 / 배포 식별자 ────────────────────────────────────────
VEHICLE_ID=AP500L-001

# ── 카메라 장치 ───────────────────────────────────────────────
CAM0_DEVICE=/dev/video0
CAM1_DEVICE=/dev/video1
CAM2_DEVICE=/dev/video2
CAM_WIDTH=640
CAM_HEIGHT=360
JPEG_QUALITY=90

# ── 카메라 publish FPS ────────────────────────────────────────
# GStreamer videorate 로 디바이스 원본 fps 에서 다운샘플
# 디바이스가 30fps 여도 이 값으로 제어됨
# 분당 프레임 수 = CAM_PUBLISH_FPS × 60
#   1  → 분당  60장
#   2  → 분당 120장
#   5  → 분당 300장
CAM_PUBLISH_FPS=1

# ── GNSS (Novotel TCP) ────────────────────────────────────────
GNSS_TCP_PORT=1111
GNSS_SRC_IP=192.168.20.50
GNSS_ROLL_MINUTES=1  # gps 저장 단위 ex.1분

# ── Kafka REST Proxy v3 ───────────────────────────────────────
BROKER_REST_URL=https://221.147.232.196:8443/poc/kafka-rest
BROKER_CLUSTER_ID=Some(red-poc-kraft-cluster)
BROKER_REST_TLS_VERIFY=false

# ── 개별 센서 토픽 ────────────────────────────────────────────
BROKER_TOPIC_CAM0=sensor.cam0.jpeg
BROKER_TOPIC_CAM1=sensor.cam1.jpeg
BROKER_TOPIC_CAM2=sensor.cam2.jpeg
BROKER_TOPIC_GNSS=sensor.gnss

# ── FusedFrame 토픽 ───────────────────────────────────────────
# USB 있으면 로컬 저장 / USB 없으면 Kafka 전송 (개별 토픽과 동일 분기)
BROKER_TOPIC_FUSED=sensor.fused

# timesync 허용 오차 (ms)
# 이 값보다 오래된 센서 프레임은 fused 에서 제외됨
# ex) 200ms: 1.5초 이내 프레임만 같은 묶음으로 처리 why? 수집 시간보다 짧아서 
FUSED_WINDOW_MS=FUSED_WINDOW_MS=1500

# fused publish 주기 (초) — CAM_PUBLISH_FPS 와 맞추는 것 권장
FUSED_INTERVAL_S=1.0

# 최소 카메라 수 — 이 수 미달 시 해당 주기 skip (1~3)
FUSED_MIN_CAMS=1

# GNSS 없으면 skip?
#   0 = gnss 없어도 cam 만으로 fused 전송 (정상동작)
#   1 = gnss 있을 때만 전송
FUSED_REQUIRE_GNSS=0

# ── gRPC 포트 ─────────────────────────────────────────────────
SERVICE_GRPC_PORT=50051
GATEWAY_GRPC_PORT=50050

# ── Harbor 이미지 레지스트리 ──────────────────────────────────
REGISTRY=
IMAGE_TAG=1.0.0

# PARQUET_ROLL_ROWS=500
USB_MOUNT_ROOT=/media/swm