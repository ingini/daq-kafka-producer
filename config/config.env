# ============================================================
#  daq-kafka-producer  배포 설정
#  이 파일만 수정하면 됩니다.
# ============================================================

# ── 차량 / 배포 식별자 ────────────────────────────────────────
VEHICLE_ID=AP500L-001

# ── 카메라 장치 ───────────────────────────────────────────────
CAM0_DEVICE=/dev/video0
CAM1_DEVICE=/dev/video1
CAM2_DEVICE=/dev/video2
CAM_WIDTH=640
CAM_HEIGHT=360
JPEG_QUALITY=90

# ── GNSS (BynavX1 UDP) ────────────────────────────────────────
GNSS_UDP_PORT=1111
GNSS_SRC_IP=192.168.20.50

# ── Remote Kafka Broker (REST Proxy) ─────────────────────────
# Confluent REST Proxy가 떠 있는 원격 서버 URL
BROKER_REST_URL=http://10.0.0.1:8082

BROKER_TOPIC_CAM0=sensor.cam0.jpeg
BROKER_TOPIC_CAM1=sensor.cam1.jpeg
BROKER_TOPIC_CAM2=sensor.cam2.jpeg
BROKER_TOPIC_GNSS=sensor.gnss

# ── gRPC 포트 ─────────────────────────────────────────────────
# daq-service (내부): dashboard에서 직접 접근 안 함
SERVICE_GRPC_PORT=50051
# daq-gateway (외부): tablet dashboard가 접속하는 포트
GATEWAY_GRPC_PORT=50050

# ── Harbor 이미지 레지스트리 ──────────────────────────────────
# 빌드 후 push/pull 할 레지스트리 주소
# 로컬 빌드만 할 경우 비워두세요
REGISTRY=
IMAGE_TAG=1.0.0

# PARQUET_ROLL_ROWS=500   # 기본값 1000
USB_MOUNT_ROOT=/media/swm